# Used by Home Manager and should stay in sync with it.

tap "brunobonacci/lazy-tools"
tap "jimeh/emacs-builds"

# curl: forced by HOMEBREW_FORCE_BREWED_CURL=1 (home/macOS.nix), so
# Homebrew uses its own keg-only curl for downloads. The interactive
# curl on PATH still comes from Nix (unstable.curl). Declared here so
# brew bundle cleanup does not flag it (and its libssh2 dep) as drift.
brew "curl"
brew "enchant" # Spellchecker wrapping library (also in nixpkgs; keep in sync)
brew "jenv" # Consider pkgs.jdk + home-manager PATH management
brew "lft" # kept because it's not found in nixpkgs 25.11
brew "likec4" # vs-code extension dependency
brew "meson" # Fast and user friendly build system
brew "pkgconf" # pkg-config implementation (Homebrew name)
brew "texlive" # Complex meta-package; brew's texlive handles macOS
               # font/path registration more reliably than nixpkgs
               # texlive.combined.*
brew "zsh-autocomplete" # No equivalent home-manager module

# Fonts are managed by nix-darwin (fonts.packages in hosts/macOS.nix),
# which rsyncs them to /Library/Fonts/Nix Fonts/ and makes them visible to Core Text
# and all macOS apps. No Homebrew casks needed.

# Keep GUI apps handled by Brewfile for best macOS integration.
#
# Emacs: do not replace with nixpkgs emacs. Emacs is installed via
# jimeh/emacs-builds, which provides nightly and release .app bundles
# with native compilation and macOS-native UI optimisations. See:
# https://github.com/jimeh/emacs-builds
cask "jimeh/emacs-builds/emacs-app"
cask "appcleaner"
cask "firefox@developer-edition"
cask "flux-app"
cask "ghostty"
cask "docker-desktop" # Docker Desktop (GUI + daemon)
cask "google-chrome"
cask "google-chrome@canary"
cask "inkscape"
cask "itraffic"
cask "libreoffice"
cask "macfuse"
cask "notunes"
cask "rectangle"
cask "slack@beta"
cask "visual-studio-code" # macOS GUI install; extensions managed via vscode "..." below
cask "vlc"
cask "goldenpassport" # Google Authenticator clone (TOTP)
cask "localsend" # Cross-platform AirDrop alternative
cask "middleclick" # Three/four-finger trackpad tap → middle click
cask "notion" # Notes/wiki
cask "notion-calendar" # Calendar
cask "gimp"

# AI coding tools — not packaged in nixpkgs, so the Homebrew cask is the
# canonical install on macOS.
cask "claude" # Claude desktop app
cask "claude-code" # Claude Code CLI
cask "codex" # OpenAI Codex CLI (depends on the ripgrep formula)
cask "codex-app" # Codex desktop app

# visualvm: installed via this cask on macOS (native VisualVM.app); on
# linux-laptop (Linux) it comes from nixpkgs (home/linux-laptop.nix). Splitting the
# two mechanisms avoids a duplicate Nix copy on macOS.
cask "visualvm"
vscode "likec4.likec4-vscode"
